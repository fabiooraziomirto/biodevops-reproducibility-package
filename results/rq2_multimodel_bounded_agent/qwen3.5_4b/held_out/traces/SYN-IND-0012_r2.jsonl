: "CAPA_INVESTIGATE", "requires_human_review": true, "severity": 2}, "final_report_sha256": "792e46c87e202fa140f57e0e683336462b4bbeec03f95b255de04abe67178668", "generation_source": "ollama_real", "invalid_proposals": 1, "is_fallback": false, "is_mock": false, "opa_actions": ["technical_incident_missing_technical_evidence", "deny:technical_incident_missing_technical_evidence"], "recommendation": "CAPA_INVESTIGATE", "record_type": "terminal", "report_id": "SYN-IND-0012", "retrievals": 1, "revisions": 1, "run_id": "SYN-IND-0012_r2", "scenario_id": "SYN-IND-0012", "schema_version": "2.1.0", "severity": 2, "shacl_findings": [], "state_terminal": "terminal", "termination_reason": "human escalation or invalid transition", "timestamp_utc": "2026-08-04T18:56:13.221556Z", "total_steps": 6, "trace_id": "285662bc-b132-49bb-989c-9c65eb0df719"}
