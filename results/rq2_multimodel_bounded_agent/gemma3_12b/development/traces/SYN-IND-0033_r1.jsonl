h requires a robust software development lifecycle including risk management and verification/validation.", "recommendation": "CAPA_INVESTIGATE", "requires_human_review": true, "severity": 3}, "final_report_sha256": "8b1abb73a037118ef4176f657129fd0fd09ef22b1e798ae069139d94a2b87c41", "generation_source": "ollama_real", "invalid_proposals": 0, "is_fallback": false, "is_mock": false, "opa_actions": ["technical_incident_missing_technical_evidence", "deny:technical_incident_missing_technical_evidence"], "recommendation": "CAPA_INVESTIGATE", "record_type": "terminal", "report_id": "SYN-IND-0033", "retrievals": 1, "revisions": 0, "run_id": "SYN-IND-0033_r1", "scenario_id": "SYN-IND-0033", "schema_version": "2.1.0", "severity": 3, "shacl_findings": [], "state_terminal": "terminal", "termination_reason": "human escalation or invalid transition", "timestamp_utc": "2026-08-04T21:25:05.007419Z", "total_steps": 5, "trace_id": "eaf78272-2a5b-4002-a6d2-c48f77c4c025"}
