 was detected internally.", "recommendation": "NO_ACTION", "requires_human_review": true, "severity": 1}, "final_report_sha256": "222f17fd3693b248d2c137be3620867c9aff3940831eacd46c1f08e5fa2896af", "generation_source": "ollama_real", "invalid_proposals": 0, "is_fallback": false, "is_mock": false, "opa_actions": [], "recommendation": "NO_ACTION", "record_type": "terminal", "report_id": "SYN-IND-0002", "retrievals": 1, "revisions": 0, "run_id": "SYN-IND-0002_r5", "scenario_id": "SYN-IND-0002", "schema_version": "2.1.0", "severity": 1, "shacl_findings": [], "state_terminal": "terminal", "termination_reason": "advisory_complete", "timestamp_utc": "2026-08-05T02:08:26.424880Z", "total_steps": 4, "trace_id": "dc6bbd03-707f-4f0e-afa9-2acce3fcbf93"}
