quires_human_review": true, "severity": 2}, "final_report_sha256": "d71cea2940f78813a50c7575fe62066d27f7ca3fd499822340cb48f534516b0c", "generation_source": "ollama_real", "invalid_proposals": 0, "is_fallback": false, "is_mock": false, "opa_actions": [], "recommendation": "CAPA_INVESTIGATE", "record_type": "terminal", "report_id": "SYN-IND-0040", "retrievals": 1, "revisions": 0, "run_id": "SYN-IND-0040_r4", "scenario_id": "SYN-IND-0040", "schema_version": "2.1.0", "severity": 2, "shacl_findings": [], "state_terminal": "terminal", "termination_reason": "advisory_complete", "timestamp_utc": "2026-08-04T17:50:09.161378Z", "total_steps": 4, "trace_id": "9b2e2d07-2fa6-4c9a-abd9-0a64d03324d2"}
